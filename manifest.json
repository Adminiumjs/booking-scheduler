  "pages": [
    {
      "ref": "bookings-dashboard",
      "template": "page-dashboard",
      "title": {
        "key": "mft.bookings.page.dashboard",
        "fallback": "Dashboard"
      },
      "nav": {
        "group": "manifest:bookings",
        "icon": "layout-dashboard",
        "order": 1
      }
    },
    {
      "ref": "bookings-calendar",
      "template": "page-calendar",
      "title": {
        "key": "mft.bookings.page.calendar",
        "fallback": "Calendar"
      },
      "nav": {
        "group": "manifest:bookings",
        "icon": "calendar-days",
        "order": 2
      }
    },
    {
      "ref": "bookings-appointments",
      "template": "page-queue-inbox",
      "title": {
        "key": "mft.bookings.page.appointments",
        "fallback": "Appointments"
      },
      "nav": {
        "group": "manifest:bookings",
        "icon": "calendar-check",
        "order": 3
      }
    },
    {
